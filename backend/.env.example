# Copy this file to ".env" and edit. Everything is optional.
# With no settings at all, the app uses Ollama if it is running, otherwise Demo mode.

# --- Local models (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=8192          # context window size for Ollama (default 8192)

# --- Debate reply detail level ---
# ANSWER_DETAIL=brief          # "brief" (25 words, default) or "detailed" (60-80 words)

# --- Optional cloud model (any OpenAI-compatible API) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL=gpt-4o-mini
# LLM_JUDGE_MODEL=            # optional: a different model for the Judge

# --- Optional price per 1 million tokens (for the Cost box; local models are free) ---
# PRICE_IN_PER_1M=0.15
# PRICE_OUT_PER_1M=0.60

# --- Evidence Agent: look up Wikipedia snippets (needs internet) ---
ENABLE_WIKIPEDIA=false

# --- Demo mode speed: delay per word in seconds ---
DEMO_WORD_DELAY=0.035
